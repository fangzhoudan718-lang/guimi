Mods: {
	zhashi: {
		# ==========================================
		#              Custom Messages
		# ==========================================
		Messages: {
			SpiritCurrents: {
				Haste: Spirit Current—Haste. The distance ahead draws closer.
				Insight: Spirit Current—Insight. Hidden information rises to the surface.
				Weightless: Spirit Current—Weightless. Reality's pull grows faint.
				Rest: Spirit Current—Rest. Gentle spirituality gathers around you.
				Discovery: You identify a new region of the Spirit World (discovered: {0}).
			}

			SealedArtifact: {
				Restless: The Gray Clover grows restless. Its misfortune is becoming certainty rather than chance.
				Dangerous: The Gray Clover's seal is loosening. Remove it or suppress it with an Apprentice Pathway Beyonder Characteristic.
				Suppressed: The characteristic merges into the seal, and the Gray Clover falls quiet for now.
				Outbreak: The Gray Clover briefly awakens. Something follows your misfortune into reality.
				TooltipActivity: "[Activity {0}/100] Accidents worsen while equipped; at full Activity, misfortune erupts."
				TooltipContainment: "[Containment] Activity fades while unequipped; an Apprentice characteristic reduces it by 45."
			}

			SpiritTools: {
				CompassHint: The Spirit Compass points {0}; the nearest unknown region is about {1} sectors away.
				CompassComplete: The compass slows to a stop. It recognizes no unknown region nearby.
			}

			DoorCurioSpiritualityCost: Consumes {0} spirituality
			DoorCurioNotEnoughSpirituality: Not enough spirituality; {0} required

			Flavor: {
				GuardianStandFirm: You did not step back.
				GuardianRescue: "{0} stood between you and death."
				BloodMoonOmen: The moon reflected in the water is beginning to bleed.
				EclipseOmen: A piece is missing from the sun, and the shadow is full of eyes.
				InvasionOmen: Many disorderly footsteps are converging on one place.
				SlimeRainOmen: The sky feels unusually soft.
				BossOmen: A vast shadow presses down upon the candle of fate.
				GraveyardOmen: Someone is knocking from below. It may be best not to answer.
				RainOmen: An unfinished warning hides among the raindrops.
				DuskOmen: Something seems to be following the final ray of sunlight.
				DawnOmen: A pale page of fate is turning in the east.
				DiceRepeat: The die has rolled {0} {1} times in a row. Fate may be stressing a point.
				DiceTripleOne: Three ones in a row. Surely the next roll cannot be worse—probably.
				DiceTripleSix: Three sixes in a row. This die is beginning to look suspicious.
				DoorClosedBehind: The door behind you closed on its own.
				MonocleOtherSide: You remember the lens being on the other side.
			}

			PathwayTownChat: {
				GuideFool: You look... different from yesterday. Never mind. Stranger things happen here daily.
				NurseMoon: I cannot decide whether to give you blood or take a sample for research.
				ArmsDealerHunter: You make my sales and my insurance premiums rise together.
				GoblinError: I definitely left that wrench here... Why are you smiling?
				WizardDoor: Doors lead to distant places—and places best left unopened. The second part matters more.
				TaxCollectorEmperor: Your Majesty, might we discuss this year's tax rate in private?
				DryadSun: Your light is warm, but the forest dislikes having nowhere to hide.
				ClothierDemoness: Mirrors sometimes lie. Trust me, I learned that the hard way.
				TavernkeepGiant: Anyone willing to stand before their companions rarely buys their own drink.
				PartyGirlWheel: I flipped a coin to decide on tonight's party. It landed heads ten times!
			}

			SpiritualityExhausted: Spirituality exhausted!
			RitualComplete: Ritual Complete: {0}
			ParasiteSuccess: Parasitized {0} (Regen Mode)
			ParasiteDeep: Deeply Parasitized {0} (Control/Steal Mode)
			ParasiteFail: Not enough Spirituality to parasitize!
			NoTarget: No valid target found.
			DeceitDomainOn: Deceit Domain: Reality distorted.
			DeceitDomainOff: Deceit Domain: Deactivated.
			TimeClockOn: Authority of Time: The Ancient Clock descends.
			TimeClockOff: Time phantom dissipates.
			MiracleWish: "[Miracle Wish]: {0} (Hold to cast)"
			MiracleLife: Life Restoration
			MiracleDestroy: Cataclysm
			MiracleTeleport: Teleportation
			MiracleDayNight: Day/Night Cycle
			PaperFigurine: Paper Figurine Substitute!
			DamageAvoided: Damage Avoided!
			AntiDivination: Anti-Divination triggered!
			IntuitionDodge: Intuitive Dodge!
			StealModeOn: Theft Mode: ON
			StealModeOff: Theft Mode: OFF
			StealSuccess: Stolen!
			FateSteal: Fate Stolen!
			TimeSteal: Time Stolen! -{0}
		}

		Items: {
			# ==========================================
			#              Special Items
			# ==========================================
			BlasphemySlate: {
				DisplayName: Blasphemy Slate
				Tooltip:
					'''
					This ancient slate is inscribed with blasphemous text...
					It records lost potion formulas.
					[c/FFA500:【Consumable】Can be used as a material for any Sequence Potion]
					(The slate will shatter upon use)
					'''
			}

			PaperCard: {
				DisplayName: Tarot Card
				Tooltip:
					'''
					Sequence 8: Clown's common weapon.
					Seemingly ordinary cards, but sharp as blades when infused with spirituality.
					'''
			}

			ExtraordinaryBlood: {
				DisplayName: Extraordinary Blood
				Tooltip: Blood containing extraordinary power.
			}

			TestSummon: {
				DisplayName: Test Summon Staff
				Tooltip: Developer item for testing summon mechanics.
			}

			RoselleDiary: {
				DisplayName: Roselle's Diary
				Tooltip:
					'''
					"The taste of a Demoness isn't bad..."
					But this page seems to be about something else.
					<Left Click to read the beginner's guide>
					'''
			}

			UnshadowedCross: {
				DisplayName: Unshadowed Cross
				Tooltip:
					'''
					[c/FFD700:【Unique Artifact】]
					"Praise the Sun!"

					[c/FFA07A:Effect:]
					Use to precipitate Beyonder characteristics from your body.
					Lowers your Sequence level by 1 each use (e.g., Seq 1 -> Seq 2).
					Repeated use will eventually revert you to a mortal.
					This item contains eternal divinity and will not be consumed or destroyed.
					'''
			}

			PaperFigurine: {
				DisplayName: Paper Figurine
				Tooltip: A medium for the Sequence 4: Paper Figurine Substitute ability.
			}

			DogItem: {
				DisplayName: Dog Whistle
				Tooltip: Used to call your Extraordinary Dog.
			}

			ResurrectionReset: {
				DisplayName: Reset Resurrection (Test)
				Tooltip: Instantly resets all resurrection cooldowns.
			}

			RitualInstaComplete: {
				DisplayName: Instant Ritual (Test)
				Tooltip: Instantly completes every pathway ritual (including Door) and resets all skill cooldowns.
			}

			SpiritualityRefill: {
				DisplayName: Refill Spirituality (Test)
				Tooltip: Instantly refills spirituality.
			}

			# ==========================================
			#              Special Weapons
			# ==========================================
			# Giant Pathway
			TwilightGiantSword: {
				DisplayName: Twilight Giant Sword
				Tooltip:
					'''
					Sequence 2: Symbol of the Glory.
					Every strike ends with this, containing the authority of decay and twilight.
					Releases a twilight storm on attack, disintegrating enemy defense.
					'''
			}

			SwordOfDawn: {
				DisplayName: Sword of Dawn
				Tooltip:
					'''
					Sequence 6: Companion weapon of the Dawn Knight.
					Slashes release the brilliance of dawn, dealing devastating damage to undead.
					"Dawn arrives, darkness dissipates."
					'''
			}

			SilverRapier: {
				DisplayName: Silver Rapier
				Tooltip:
					'''
					Sequence 3: Rapier of the Silver Knight.
					The blade flows like mercury, attacking with extreme speed.
					'''
			}

			# Hunter Pathway
			ConquerorSword: {
				DisplayName: Iron-blooded Sword
				Tooltip:
					'''
					Sequence 4: Weapon of the Iron-blooded Knight.
					Forged in blood and fire, yearning for battle.
					Hits may ignite enemies.
					'''
			}

			ReaperScythe: {
				DisplayName: Reaper Scythe
				Tooltip:
					'''
					Sequence 5: Weapon of the Reaper.
					Specially designed to harvest the weaknesses of life, guaranteed critical hits.
					'''
			}

			ConquerorLance: {
				DisplayName: Conqueror's Lance
				Tooltip:
					'''
					Sequence 1: Weapon of the Conqueror.
					Indomitable, conquering all who disobey.
					'''
			}

			# Fool Pathway
			AirBullet: {
				DisplayName: Air Bullet
				Tooltip:
					'''
					Invisible bullets compressed from air.
					Power increases with Sequence advancement.
					Seq 7: Pistol
					Seq 5: Rifle
					Seq 4: Cannon
					Seq 3: Coastal Artillery
					'''
			}

			# ==========================================
			#              Core Materials
			# ==========================================
			WeatherRune: {
				DisplayName: Weather Rune
				Tooltip:
					'''
					A rune containing ancient weather power, crackling with lightning and frost.
					Key medium for advancing to Sequence 2: Weather Warlock.
					'''
			}

			ConquerorCharacteristic: {
				DisplayName: Conqueror Characteristic
				Tooltip:
					'''
					A crystal precipitated from the Red Priest Pathway Sequence 1 characteristic.
					Holding it, you feel the majesty of commanding armies.
					Used for advancing to Sequence 1: Conqueror.
					'''
			}

			WhisperOfSpiritWorld: {
				DisplayName: Whisper of the Spirit World
				Tooltip:
					'''
					Vague information from the depths of the Spirit World.
					Use it to attempt to decipher a 'True Name'.
					[Warning]: Failure will result in backlash from the Moon (Heavy Damage/Debuff).
					'''
			}

			TrueNameInscription: {
				DisplayName: True Name Inscription
				Tooltip:
					'''
					A segment of special information defined and intertwined with your fate.
					Core material for the Sequence 3: Summoning Master potion.
					'''
			}

			# ==========================================
			#              Moon Pathway Potions
			# ==========================================
			ApothecaryPotion: {
				DisplayName: Sequence 9: Apothecary Potion
				Tooltip:
					'''
					Advance to Apothecary.
					Grants poison resistance and increased life regeneration.
					Skilled in concocting potions and healing.
					'''
			}

			BeastTamerPotion: {
				DisplayName: Sequence 8: Beast Tamer Potion
				Tooltip:
					'''
					Advance to Beast Tamer.
					Allows you to tame beasts, increases minion slots.
					Grants danger sense.
					'''
			}

			VampirePotion: {
				DisplayName: Sequence 7: Vampire Potion
				Tooltip:
					'''
					Advance to Vampire.
					Grants Wings of Darkness and super self-healing.
					An elegant hunter in the dark, but detests sunlight.
					'''
			}

			PotionsProfessorPotion: {
				DisplayName: Sequence 6: Potions Professor Potion
				Tooltip:
					'''
					Advance to Potions Professor.
					Master the mysteries of alchemy.
					Can use Alchemical Grenades and Elixirs of Life.
					'''
			}

			ScarletScholarPotion: {
				DisplayName: Sequence 5: Scarlet Scholar Potion
				Tooltip:
					'''
					Advance to Scarlet Scholar.
					Control moonlight and shadows.
					Unlocks Full Moon Domain, grants Moonlight Transformation.
					'''
			}

			WitchKingPotion: {
				DisplayName: Sequence 4: Shaman King Potion
				Tooltip:
					'''
					Advance to Shaman King.
					The beginning of demigodhood, extremely long lifespan.
					Grants Bat Swarm, Paper Figurine Substitute, and Gaze of Darkness.
					'''
			}

			SummoningMasterPotion: {
				DisplayName: Sequence 3: Summoning Master Potion
				Tooltip:
					'''
					Advance to Summoning Master.
					Can open the Summoning Door to call spirit world creatures for aid.
					Drastically improves summoning capabilities.
					'''
			}

			LifeGiverPotion: {
				DisplayName: Sequence 2: Life Giver Potion
				Tooltip:
					'''
					Advance to Life Giver.
					Master of life, possessing incredible healing and creative powers.
					Unlocks Creation Domain, purifies the land, creates miracles of life.
					'''
			}

			BeautyGoddessPotion: {
				DisplayName: Sequence 1: Beauty Goddess Potion
				Tooltip:
					'''
					Advance to Beauty Goddess.
					The embodiment of beauty, all things bow down.
					[Warning]: Gender will be converted to Female upon consumption.
					Grants Charm Aura and god-level power.
					'''
			}

			# ==========================================
			#              Hunter Pathway Potions
			# ==========================================
			HunterPotion: {
				DisplayName: Sequence 9: Hunter Potion
				Tooltip:
					'''
					Advance to Hunter.
					Excellent physical fitness and senses.
					Grants creature detection ability.
					'''
			}

			ProvokerPotion: {
				DisplayName: Sequence 8: Provoker Potion
				Tooltip:
					'''
					Advance to Provoker.
					Skilled in attracting aggro and making traps.
					'''
			}

			PyromaniacPotion: {
				DisplayName: Sequence 7: Pyromaniac Potion
				Tooltip:
					'''
					Advance to Pyromaniac.
					Control the power of fire.
					Grants Pyrokinesis, Fireballs, and Fire Resistance.
					'''
			}

			ConspiratorPotion: {
				DisplayName: Sequence 6: Conspirator Potion
				Tooltip:
					'''
					Advance to Conspirator.
					Quick-witted, skilled in guiding the battle.
					Grants Flash (Teleport) and Weapon Enchantment.
					'''
			}

			ReaperPotion: {
				DisplayName: Sequence 5: Reaper Potion
				Tooltip:
					'''
					Advance to Reaper.
					Deadly weakness attacks.
					Grants Deadly Slash, drastically increases critical strike chance.
					'''
			}

			IronBloodedKnightPotion: {
				DisplayName: Sequence 4: Iron-blooded Knight Potion
				Tooltip:
					'''
					Advance to Iron-blooded Knight.
					Will and body of steel.
					Grants Flame Form and Army of One ability.
					'''
			}

			WarBishopPotion: {
				DisplayName: Sequence 3: War Bishop Potion
				Tooltip:
					'''
					Advance to War Bishop.
					Commander of the battlefield, mental connection.
					'''
			}

			WeatherWarlockPotion: {
				DisplayName: Sequence 2: Weather Warlock Potion
				Tooltip:
					'''
					Advance to Weather Warlock.
					Call wind and rain, control the weather.
					Grants Lightning Strike and Ice Age abilities.
					'''
			}

			ConquerorPotion: {
				DisplayName: Sequence 1: Conqueror Potion
				Tooltip:
					'''
					Advance to Conqueror.
					Conquer all who disobey.
					Stops enemy spawns nearby, overwhelming stats.
					'''
			}

			# ==========================================
			#              Giant Pathway Potions
			# ==========================================
			WarriorPotion: {
				DisplayName: Sequence 9: Warrior Potion
				Tooltip: Increases melee capabilities.
			}

			PugilistPotion: {
				DisplayName: Sequence 8: Pugilist Potion
				Tooltip: Improves fighting techniques and knockback resistance.
			}

			WeaponMasterPotion: {
				DisplayName: Sequence 7: Weapon Master Potion
				Tooltip: Mastery of all weapons.
			}

			DawnKnightPotion: {
				DisplayName: Sequence 6: Dawn Knight Potion
				Tooltip: Grants Dawn Armor, shining light everywhere.
			}

			GuardianPotion: {
				DisplayName: Sequence 5: Guardian Potion
				Tooltip: Guardian Stance, indestructible.
			}

			DemonHunterPotion: {
				DisplayName: Sequence 4: Demon Hunter Potion
				Tooltip: Immune to curses, restrains evil.
			}

			SilverKnightPotion: {
				DisplayName: Sequence 3: Silver Knight Potion
				Tooltip: Become mercury, elusive.
			}

			GloryPotion: {
				DisplayName: Sequence 2: Glory Potion
				Tooltip: Twilight Resurrection, immortal glory.
			}

			# ==========================================
			#              Fool Pathway Potions
			# ==========================================
			SeerPotion: {
				DisplayName: Sequence 9: Seer Potion
				Tooltip:
					'''
					Advance to Seer.
					Grants Spirit Vision and Divination, avoiding danger.
					'''
			}

			ClownPotion: {
				DisplayName: Sequence 8: Clown Potion
				Tooltip: Advance to Clown.
			}

			MagicianPotion: {
				DisplayName: Sequence 7: Magician Potion
				Tooltip:
					'''
					Advance to Magician.
					Grants Damage Transfer, Bone Softening, Air Bullet.
					Grants Flame Jump and Paper Figurine Substitute.
					'''
			}

			FacelessPotion: {
				DisplayName: Sequence 6: Faceless Potion
				Tooltip:
					'''
					Advance to Faceless.
					Changeable, grants Faceless Disguise.
					'''
			}

			MarionettistPotion: {
				DisplayName: Sequence 5: Marionettist Potion
				Tooltip:
					'''
					Advance to Marionettist.
					Control Spirit Body Threads, convert all things into puppets.
					'''
			}

			BizarroSorcererPotion: {
				DisplayName: Sequence 4: Bizarro Sorcerer Potion
				Tooltip:
					'''
					Advance to Bizarro Sorcerer (Demigod).
					Possess Spirit Worms, Marionette Swap, and Spirit Control.
					'''
			}

			ScholarOfYorePotion: {
				DisplayName: Sequence 3: Scholar of Yore Potion
				Tooltip:
					'''
					Advance to Scholar of Yore (Saint).
					Borrow power from history, summon phantoms of the past.
					'''
			}

			MiracleInvokerPotion: {
				DisplayName: Sequence 2: Miracle Invoker Potion
				Tooltip:
					'''
					Advance to Miracle Invoker (Angel).
					A miracle walking in reality, interfere with fate, grant wishes.
					'''
			}

			AttendantPotion: {
				DisplayName: Sequence 1: Attendant of Mysteries Potion
				Tooltip:
					'''
					Advance to Attendant of Mysteries (King of Angels).
					Dominate the Spirit World, graft concepts, establish a divine kingdom.
					'''
			}

			# ==========================================
			#              Marauder Pathway Potions
			# ==========================================
			MarauderPotion: {
				DisplayName: Sequence 9: Marauder Potion
				Tooltip:
					'''
					Advance to Marauder.
					Agile body, nimble fingers.
					Grants [Theft] ability, gaining extra loot from enemies.
					'''
			}

			SwindlerPotion: {
				DisplayName: Sequence 8: Swindler Potion
				Tooltip:
					'''
					Advance to Swindler.
					Skilled in deception and misleading.
					Chance to get discounts when buying items.
					'''
			}

			CryptologistPotion: {
				DisplayName: Sequence 7: Cryptologist Potion
				Tooltip:
					'''
					Advance to Cryptologist.
					Sharp intuition, skilled at finding weaknesses.
					Increases critical chance and armor penetration.
					'''
			}

			PrometheusPotion: {
				DisplayName: Sequence 6: Prometheus Potion
				Tooltip:
					'''
					Advance to Prometheus.
					A thief who steals power.
					Increases theft success rate, can steal enemy buffs.
					'''
			}

			DreamStealerPotion: {
				DisplayName: Sequence 5: Dream Stealer Potion
				Tooltip:
					'''
					Advance to Dream Stealer.
					Invade dreams, manipulate consciousness.
					Attacks may confuse or put enemies to sleep.
					'''
			}

			ParasitePotion: {
				DisplayName: Sequence 4: Parasite Potion
				Tooltip:
					'''
					Advance to Parasite (Demigod).
					Parasitize all things, gain immortality.
					Press [P] to parasitize target, reform body with worms.
					'''
			}

			MentorPotion: {
				DisplayName: Sequence 3: Mentor of Deceit Potion
				Tooltip:
					'''
					Advance to Mentor of Deceit (Saint).
					Deceive rules, mislead all living things.
					Unlock Deceit Domain, distort enemy cognition.
					'''
			}

			TrojanHorsePotion: {
				DisplayName: Sequence 2: Trojan Horse of Destiny Potion
				Tooltip:
					'''
					Advance to Trojan Horse of Destiny (Angel).
					Steal fate, tamper with the future.
					Grants Fate Theft ability, substitute death with past self.
					'''
			}

			WormOfTimePotion: {
				DisplayName: Sequence 1: Worm of Time Potion
				Tooltip:
					'''
					Advance to Worm of Time (King of Angels).
					Toy with time, steal years.
					Gain Time Domain, steal enemy time and life.
					'''
			}

