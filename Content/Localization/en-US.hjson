		# ==========================================
		#              Configs
		# ==========================================
		Configs: {
			LotMConfig: {
				DisplayName: Lord of the Mysteries Config

				Headers: {
					平衡性设置: Balance Settings
					BaseSettings: Base Settings Header
					ChallengeSettings: Challenge Settings Header
					OtherSettings: Other Settings Header
				}

				DynamicProgression: {
					Label: Enable Dynamic World Level
					Tooltip:
						'''
						Adjusts stats dynamically based on defeated bosses (Supports Calamity/Thorium).
						Recommended for the best experience.
						'''
				}

				NerfDivineAbilities: {
					Label: Balance Mechanics
					Tooltip:
						'''
						ON: Replaces 'Invincibility/Insta-kill' with 'High Damage Reduction/Percentage Damage'.
						OFF: Restores original OP strength (Canon Accurate).
						'''
				}

				GlobalPowerMultiplier: {
					Label: Global Power Multiplier
					Tooltip:
						'''
						Globally adjusts health, damage, and defense added by the mod.
						1.0 is standard, 0.5 is halved.
						'''
				}

				EnableSanitySystem: {
					Label: Enable Sanity System
					Tooltip: ""
				}

				EnableWorldRestriction: {
					Label: Enable World Restriction
					Tooltip: ""
				}

				EnableDivineCurse: {
					Label: Enable Divine Curse
					Tooltip: ""
				}

				CalamityAdaptationMode: {
					Label: 灾厄适配模式
					Tooltip:
						'''
						开启后：
						1. 玩家造成的伤害降低 60%，防御降低 40%
						2. 只有击败特定 Boss 后才能服用对应序列的魔药
						'''
				}
			}

