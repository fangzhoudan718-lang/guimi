			PolyhedronOfFate: {
				DisplayName: Polyhedron of Fate
				Tooltip:
					'''
					[c/FF0064:Sequence 1 Serpent's Sacred Relic]
					A die that picks its own number of faces, wrapped in mercury serpent scales.
					Right-click to throw: consume 800 Spirituality, randomly rolls [c/64A0FF:D4] / [c/78E682:D6] / [c/B46EFF:D8] / [c/FFD750:D10] / [c/FF8C3C:D12] / [c/FF3C50:D20].
					Each die has a totally different effect pool - elemental burn / group buff / fate rip / zodiac / final judgment...
					[c/FFD750:D20=20: Perfect Strike - max judgment on all enemies, full party restoration]
					[c/FF6464:D20=1:  Critical Fail - lose 3/4 HP, but 10 seconds of fury]
					"You watch the die leave your hand, and see every possible outcome of its landing..."
					'''
			}

			MisfortuneMagePotion: {
				DisplayName: Sequence 4: Misfortune Mage Potion
				Tooltip:
					'''
					Ascend to the Misfortune Mage (Demigod).
					[c/FF0000:Ritual: Defeat Skeletron Prime while wearing the Gray Clover]
					You see the river of fate and become the master of misfortune.
					[Passive] Massive luck, crit chance and movement speed; demigod body.
					[Passive] Senses danger, creatures, and pierces darkness.
					[Active] Misfortune Domain: enemies in range suffer curses, may drop dead.
					[Active] Fate's Blessing: overdraw fate to grant powerful buffs to you and allies.
					'''
			}

			AnomalyPotion: {
				DisplayName: Sequence 3: Anomaly Potion
				Tooltip:
					'''
					Ascend to the Anomaly (Saint).
					[c/FF0000:Ritual: While at Sequence 4, survive and recover to 60%+ HP from below 10% HP three times]
					You become the unpredictable cog in fate's machinery.
					[Passive] Anomaly Eye: +30% critical damage.
					[Passive] Improbability: 30% chance to nullify a lethal hit (30s cooldown).
					[Passive] Probability Backlash: each debuff on you grants +0.2 luck (max +1.0).
					[Passive] Chain of Misfortune: enemies dropped dead by your domain infect their neighbors.
					[Active] Fate Dice (M): consume 200 Spirituality to roll a die; each face triggers a different fate.
					'''
			}

			ProphetPotion: {
				DisplayName: Sequence 2: Prophet Potion
				Tooltip:
					'''
					Ascend to the Prophet (Demigod - the complete mythical form).
					[c/FF0000:Ritual: While at Sequence 3, trigger \"Improbability\" successfully 5 times]
					Become Fate's darling, wielding three lesser authorities: Luck, Misfortune, and Foreknowledge.
					[Passive] Fate Insight: +20% additional critical damage (total +50%).
					[Passive] Fate's Darling: +2.0 luck.
					[Passive] Mercury Body: immunity to all damage and debuffs for 10s after being hit (60s CD).
					[Passive] Prophecy: chance to prophesy your next strike upon killing; the next hit one-shots (Bosses take 20% HP).
					[Active] Words of Fortune (default K, 30s CD): 300 Spirituality, 4000-tile allies get 60s of 10 buffs, full heal & spirituality.
					[Active] Words of Misfortune (default L, 30s CD): 300 Spirituality, 4000-tile enemies take 25% current HP true damage (10% for bosses) + 60s of 8 debuffs.
					[Active] Fate's Revelation (default U, 60s CD): 500 Spirituality, 10s where all chance events lean toward the optimal outcome.
					'''
			}

			SerpentPotion: {
				DisplayName: Sequence 1: Serpent Potion
				Tooltip:
					'''
					Ascend to the Serpent (Sequence-1 Aspect of Fate / Mercury Serpent / Ouroboros).
					[c/FF0000:Ritual: While at Sequence 2, trigger Revelation 5 times AND defeat the Moon Lord]
					Become Fate incarnate, wielding the lesser authorities of Cycle, Preservation, and Choice.
					[Passive] Serpent Body: +2500 HP / +50% dmg / +35 crit / +80 def / +20% endurance / +40% atk speed / +50% move speed
					[Passive] Serpent of All: +30% crit damage (total +80%)
					[Passive] Avatar of Fate: +5.0 luck
					[Passive] Hidden Fate: immunity to nearly all debuffs
					[Passive] Mercury Phase: every 10 seconds enter 3 seconds of total invincibility
					[Passive] Restart Cycle: upon death, consume 5000 Spirituality to revert to 10 seconds ago (10min CD)
					[Active] Fate Loop (default Y): 1000 Spirituality, 800-tile range; after 5s, rolls back enemy positions (excludes Bosses)
					[Active] Manual Restart (default H): 3000 Spirituality, retreat to 10s ago with full HP & cleared debuffs (3min CD)
					'''
			}

			ApprenticePotion: {
				DisplayName: Apprentice Potion
				Tooltip: ""
			}

			LawyerPotion: {
				DisplayName: Lawyer Potion (Sequence 9)
				Tooltip: A sticky black brew that stains the very air. Only a mortal untouched by the extraordinary may drink it. Opens the Black Emperor pathway.
			}

			SavagePotion: {
				DisplayName: Savage Potion (Sequence 8)
				Tooltip: A translucent black brew with tiny organs drifting in it. Only a Sequence 9 Lawyer may drink it.
			}

			BriberPotion: {
				DisplayName: Briber Potion (Sequence 7)
				Tooltip: A fizzy, deceptively pleasant black brew. Only a Sequence 8 Savage may drink it.
			}

			CorruptBaronPotion: {
				DisplayName: Corrupt Baron Potion (Sequence 6)
				Tooltip: A sweet-smelling, faintly translucent dark brew with a hint of rot beneath. Only a Sequence 7 Briber may drink it.
			}

			ChaosMentorPotion: {
				DisplayName: Chaos Mentor Potion (Sequence 5)
				Tooltip: A pitch-black brew that swirls and pulses on its own. Only a Sequence 6 Corrupt Baron may drink it.
			}

			FallenEarlPotion: {
				DisplayName: Fallen Earl Potion (Sequence 4)
				Tooltip: A half-solid eye forms in the black brew and weeps rot. Only a Sequence 5 Chaos Mentor who has finished the ritual may drink it.
			}

			RageMagePotion: {
				DisplayName: Rage Mage Potion (Sequence 3)
				Tooltip: Crimson magma split into three unequal parts by black slime. Only a Sequence 4 Fallen Earl who survived three ritual battles may drink it.
			}

			EntropyDukePotion: {
				DisplayName: Entropy Duke Potion (Sequence 2)
				Tooltip: Clear liquid in which black script weaves itself into a crown. Only a Sequence 3 Rage Mage who has finished the ritual may drink it.
			}

			UsurperPrincePotion: {
				DisplayName: Usurper Prince Potion (Sequence 1)
				Tooltip: A translucent black brew reflecting a twisted brass figure. Only a Sequence 2 Entropy Duke who has finished the ritual may drink it.
			}

			SpiritEssence: {
				DisplayName: Apprentice Pathway Beyonder Characteristic
				Tooltip:
					'''
					A Beyonder characteristic left when a Door pathway Beyonder falls. Higher sequences leave more behind.
					Use while carrying an active sealed artifact to reduce its Activity by 45.
					'''
			}

			SpiritCompass: {
				DisplayName: Spirit Compass
				Tooltip: Use in the Spirit World to point toward the nearest unexplored region.\nIt does not point north—only toward what you do not yet know.
			}

			WallpassingKey: {
				DisplayName: Wallpassing Key
				Tooltip:
					'''
					Passes through a wall up to 160 pixels thick toward the cursor
					Cannot open where there is no safe landing point
					'''
				NoPassageText: There is no safe footing beyond the door
			}

			SpatialPocket: {
				DisplayName: Spatial Pocket
				Tooltip:
					'''
					Opens a private portable space connected to your Piggy Bank
					Stored items remain in the original Piggy Bank inventory
					'''
			}

			TricksterWand: {
				DisplayName: Trickster Wand
				Tooltip:
					'''
					Randomly fires one of six gem trick bolts
					Each shot bends slightly in flight
					'''
			}

			AstrologerCompass: {
				DisplayName: Astrologer's Compass
				Tooltip:
					'''
					Reveals treasure, danger, and nearby creatures
					+4% critical strike chance and +0.05 luck
					'''
			}

			RecordingQuill: {
				DisplayName: Recording Quill
				Tooltip:
					'''
					Records the first enemy struck
					Reenacts one third of that damage after a short delay
					'''
			}

			TravelerBoots: {
				DisplayName: Traveler's Ankle Boots
				Tooltip:
					'''
					+14% movement speed, improved running and jumping
					Prevents fall damage
					'''
			}

			BlinkDagger: {
				DisplayName: Blink Dagger
				Tooltip:
					'''
					Blinks to a safe position beyond a struck enemy
					Searches nearby in cramped terrain and briefly grants immunity
					'''
			}

			BanishmentBell: {
				DisplayName: Banishment Bell
				Tooltip:
					'''
					Pushes and slows enemies within 300 pixels
					Normal enemies are confused; bosses suffer weaker force
					'''
			}

			MirrorDoorShard: {
				DisplayName: Mirror-Door Shard
				Tooltip:
					'''
					6% damage reduction and longer immunity after being hit
					Enemies are less likely to focus on you
					'''
			}

			StarThreadSpool: {
				DisplayName: Star-Thread Spool
				Tooltip:
					'''
					+8% magic damage and attack speed
					+4% magic critical strike chance
					'''
			}

			DoorwayChalk: {
				DisplayName: Doorway Chalk
				Tooltip:
					'''
					First use marks your position; use again to return and erase it
					Marks do not persist between worlds or sessions
					'''
				MarkedText: A return door has been drawn
				ReturnedText: The return door folds shut
				BlockedText: Solid blocks now occupy the marked position
			}

			PocketDoorLantern: {
				DisplayName: Pocket Door Lantern
				Tooltip:
					'''
					Provides subdued spatial light and danger sense
					Slightly lowers enemy aggression
					'''
			}

			LesserSpiritualityPotion: {
				DisplayName: Lesser Spirituality Potion
				Tooltip: Restores a little spirituality. Brewed from a tombstone or an Apprentice pathway characteristic.
			}

			SpiritualityPotion: {
