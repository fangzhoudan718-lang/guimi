					表面刻有繁复赫密斯语铭文的特制炼金子弹。
					在这个污秽潜藏的世界里，唯有附带神圣力量的银光能净化一切。
					击中目标时会爆发出金色的灵性光辉，对亡灵与黑暗生物具有毁灭性的打击。
					'''
			}

			NighthawkPistol: {
				DisplayName: 值夜人制式手枪
				Tooltip:
					'''
					阿霍瓦郡警察厅特殊行动部的标准配枪，枪管修长，通体漆黑。
					握把上隐约刻着象征黑夜女神的繁星圣徽，入手沉重而冰冷。
					它牺牲了部分射速以换取巨大的破坏力，那是对非凡生物的仁慈一击。
					“恐惧来自于未知，而这把枪能带给你确定的安全感。”
					'''
			}

			MysteryMusicBox1: {
				Tooltip: 《渡月桥思君--小提琴版》作者：龚明威
				DisplayName: 诡秘八音盒1
			}

			AssassinPotion: {
				Tooltip:
					'''
					序列9: 刺客
					获得夜视与生物探测能力
					变得体态轻盈，擅长在阴影中潜伏
					'''
				DisplayName: 序列9: 刺客魔药
			}

			InstigatorPotion: {
				Tooltip:
					'''
					序列8: 教唆者
					擅长诱导敌人自相残杀
					大幅降低自身仇恨，躲在幕后操纵战局
					'''
				DisplayName: 序列8: 教唆者魔药
			}

			WitchPotion: {
				Tooltip:
					'''
					序列7: 女巫
					习得黑魔法与诅咒，能造成霜冻与暗影伤害
					获得隐身能力，魅力大幅提升
					'''
				DisplayName: 序列7: 女巫魔药
			}

			PleasureDemonessPotion: {
				DisplayName: 序列6:  欢愉魔女魔药
				Tooltip:
					'''
					序列6: 欢愉魔女
					掌握魅惑与欢愉之触，能使用镜面替身
					'''
			}

			AfflictionDemonessPotion: {
				Tooltip:
					'''
					序列5: 痛苦魔女
					散播疾病与痛楚，能操纵发丝与蛛网
					'''
				DisplayName: 序列5: 痛苦魔女魔药
			}

			DespairDemonessPotion: {
				DisplayName: 序列4: 绝望魔女魔药
				Tooltip:
					'''
					序列4: 绝望魔女 (半神)
					制造黑焰与致命瘟疫，给世界带来绝望
					'''
			}

			UnagingDemonessPotion: {
				Tooltip:
					'''
					序列3: 不老魔女 (圣者)
					获得青春永驻与死而复生的能力
					能石化万物
					'''
				DisplayName: 序列3: 不老魔女魔药
			}

			CatastropheDemonessPotion: {
				Tooltip:
					'''
					序列2: 灾难魔女 (天使)
					化身为天灾，掌控风雨雷电与极寒
					'''
				DisplayName: 序列2: 灾难魔女魔药
			}

			ApocalypseDemonessPotion: {
				Tooltip:
					'''
					序列1: 末日魔女 
					象征着真正的末日与终结
					'''
				DisplayName: 序列1: 末日魔女魔药
			}

			SpiritWorldKey: {
				Tooltip:
					'''
					向未知的存在祈求，打开通往灵界的大门
					需长按右键以举行仪式
					“凡涉足灵界者，必先献祭不属于这个世界的魔力与血肉……”
					'''
				DisplayName: 灵界之匙
			}

			MirrorKey: {
				DisplayName: 镜子密钥
				Tooltip:
					'''
					开启通往镜中世界的通道
					只有掌握了欢愉与痛苦的魔女才能凝结此物
					'''
			}

			CreepingHunger: {
				Tooltip:
					'''
					一只由人皮缝制而成的手套，掌心裂开一张渴望进食的嘴。
					能够"放牧"死者的灵魂，并驱使它们使用生前的能力。
					[c/E11919:负面效果：] 极其贪婪。若每日未以强者(Boss/强怪)的血肉喂食，
					它将反噬持有者，吞食其血肉与灵魂。
					<right>打开灵界轮盘以切换或放逐灵魂。
					<left>使用当前灵魂的非凡能力。
					"凡所有相，皆是虚妄；唯有饥饿，永恒真实。"
					'''
				DisplayName: 蠕动的饥饿（测试版）
			}

			LuckEnhancementRitual: {
				DisplayName: 转运仪式
				Tooltip:
					'''
					"福生玄黄仙尊..."
					"福生玄黄天君..."
					"福生玄黄上帝..."
					"福生玄黄天尊..."
					长按以迈出逆时针的四步，并在最后一步进入灰雾之上。
					'''
			}

			Monocle: {
				Tooltip:
					'''
					“错误”途径的标志性装束。
					看起来这只是普通的装饰，但戴上它的人总想摸摸右眼。
					'''
				DisplayName: 单片眼镜
			}

			DaqianLuItem: {
				DisplayName: 大千录
				Tooltip:
					'''
					[c/880000:“这根本不是什么修仙秘籍，这是来自地狱的催命账本。”]

					[c/FFD700:【法宝特性】]
					此物不详。佩戴者将时刻遭受 [c/FF0000:血肉渴望] 的侵蚀。
					按下 [c/00FFFF:大千录：祭] 键，剜肉剔骨，以痛换力。

					[c/B0C4DE:命运轮盘：]
					[c/FF0000:大凶] - 邪神索命，万劫不复
					[c/FFA500:上签] - 借假修真，神通自来
					[c/FFFFFF:羽化] - [c/FF00FF:妈！我分清了！我是真的成仙了！！]

					“哪怕是假的，只要能杀人，那就是真的。”
					'''
			}

			CopperCoinMask: {
				Tooltip:
					'''
					[c/B8860B:“用带着陈旧污血的红绳串起铜钱，严密地遮住了那张分不清真假的脸。”]

					[c/FFD700:【心素的伪装】]
					此物通灵，随心而变。

					[c/32CD32:■ 理智高昂 (>70%) - 伪装:] 
					铜钱辟邪，心若冰清。
					获得额外的 [c/32CD32:防御力] 与 [c/32CD32:生命回复]，维持“正常人”的假象。

					[c/DC143C:■ 理智崩溃 (<30%) - 发癫:] 
					伪装撕裂，癫狂显化！
					防御力失效，但获得 [c/DC143C:15% 伤害加成] 与 [c/DC143C:10% 伤害减免]。
					耳边将回荡起铜钱碰撞的疯狂低语...

					[c/808080:“戴上它，你就是坐忘道。或者...你一直都是？”]
					'''
				DisplayName: 铜钱面罩
			}

			SacrificialCasket: {
				DisplayName: 献祭之匣
				Tooltip:
					'''
					[c/FF0000:“贪婪的虚空渴望着一切”]
					1. [右键] 拿起物品在背包中右键此匣：以 120% 价值转化为灵性
					2. [左键] 手持使用：消耗 20 生命值换取 50 灵性
					'''
			}

			RitualKnife: {
				DisplayName: 仪式铭刻刀
				Tooltip:
					'''
					按住左键消耗灵性绘制线条
					当线条首尾相交闭合时，触发大范围爆炸
					爆炸伤害取决于闭合圆环的面积
					[c/FFD700:“以笔代刀，绘制死亡”]
					'''
			}

			RitualBrush: {
				DisplayName: 仪式毛笔
				Tooltip:
					'''
					按住左键消耗灵性绘制墨痕
					墨迹会在空中长久停留
					[c/888888:“泼墨挥毫，皆为杀机”]
					'''
			}

			StarfallEtcher: {
				Tooltip:
					'''
					按住左键消耗灵性绘制粉紫色的星光轨迹
					松开鼠标时，群星将沿着你绘制的路径坠落
					[c/E180CE:“星辰回应了你的笔触”]
					'''
				DisplayName: 坠星之刻
			}

			BloodEtcher: {
				Tooltip:
					'''
					[c/FF0000:以生命为墨]
					按住左键消耗生命值绘制血痕
					造成的伤害较高
					[c/880000:“血肉苦弱，唯有牺牲永恒”]
					'''
				DisplayName: 血之刻
			}

			MonsterPotion: {
				DisplayName: 序列9：怪物魔药
				Tooltip:
					'''
					服用后晋升为怪物。
					灵感超高，能听见别人听不见的声音。
					获得[危险感知]与[生物探测]能力。
					偶尔能窥见未来的画面，提升少量运气与暴击。
					'''
			}

			RobotPotion: {
				DisplayName: 序列8：机器魔药
				Tooltip:
					'''
					服用后晋升为机器。
					获得恐怖的计算能力与精准的控制力。
					成为格斗与射击领域的天赋者。
					获得[占卜]与[反占卜]能力。
					'''
			}

			LuckyPotion: {
				Tooltip:
					'''
					服用后晋升为幸运儿。
					你的运气开始变得高低起伏，难以捉摸。
					[被动] 经常能在路上捡到钱。
					[被动] 战斗时偶尔会触发“人体描边”般的幸运闪避。
					[被动] 暴击率会随时间波动，有时极高，有时平庸。
					'''
				DisplayName: 序列7：幸运儿魔药
			}

			CalamityPriestPotion: {
				DisplayName: 序列6：灾祸教士魔药
				Tooltip:
					'''
					服用后晋升为灾祸教士。
					你将成为灾祸的管理者。
					[被动] 身边会不断发生只针对敌人的“不幸事故”。
					[主动] 精神风暴：引发精神层面的灾难，重创并混淆敌人。
					'''
			}

			BadLuckPotion: {
				// DisplayName: Bad Luck Potion
				// Tooltip: ""
			}

			WinnerPotion: {
				DisplayName: 序列5：赢家魔药
				Tooltip:
					'''
					服用后晋升为赢家。
					[c/FF0000:仪式要求：必须处于【厄运缠身】状态下服用]
					你掌控了自身的幸运，能够驾驭厄运。
					[被动] 幸运值大幅提升，压制厄运药剂的副作用。
					[被动] 子弹有几率自动追踪敌人，且不消耗弹药。
					[被动] 攻击使敌人倒霉（炸膛、破防、弱点攻击）。
					[被动] 能够以戏剧性的方式化解致命危机。
					'''
			}

			MisfortuneDie: {
				DisplayName: 【封印物】灰色四叶草
				Tooltip:
					'''
					[c/FF0000:危险级封印物]
					装备后，你将遭受难以想象的厄运。
					- 幸运值降至极低 (-10)
					- 频繁发生致命意外（雷劈、炸膛、平地摔）
					- 属性大幅削弱
					“它唯一的用途就是让持有者倒大霉。”
					[c/FF0000:警告：佩戴它即满足赢家晋升仪式的要求]
					'''
			}

			PolyhedronOfFate: {
				DisplayName: 命运多面骰
				Tooltip:
					'''
					[c/FF0064:序列1巨蛇专属圣物]
					一颗会自行选择面数的骰子,被命运之蛇的鳞片裹起来过.
					右键投掷: 消耗 800 灵性, 随机投出 [c/64A0FF:D4] / [c/78E682:D6] / [c/B46EFF:D8] / [c/FFD750:D10] / [c/FF8C3C:D12] / [c/FF3C50:D20] 之一.
					每种骰子有完全不同的效果池 —— 元素灼烧 / 群体增益 / 命运撕裂 / 黄道十二宫 / 终焉裁决...
					[c/FFD750:D20=20: 完美一击 - 全场敌人受最高判决,全队彻底恢复]
					[c/FF6464:D20=1:  致命暴击 - 砍去3/4血量, 但暴怒10秒]
					"你看着骰子离开了你的手, 却看到了它落地的所有可能性..."
					'''
			}

			MisfortuneMagePotion: {
				DisplayName: 序列4：厄运法师魔药
				Tooltip:
					'''
					服用后晋升为厄运法师 (半神)。
					[c/FF0000:仪式要求：佩戴【灰色四叶草】击败机械骷髅王]
					你看到了命运的长河，成为厄运的主宰。
					[被动] 极高的运气、暴击率与移动速度，半神级肉体。
					[被动] 察觉危险、生灵与黑暗。
					[主动] 厄运领域：范围内敌人陷入诅咒，且有几率被命运反噬而暴毙。
					[主动] 命运赐福：透支自身命运，赐予自己与友军一分钟的强大增益。
					'''
			}

			AnomalyPotion: {
				DisplayName: 序列3：混沌行者魔药
				Tooltip:
					'''
					服用后晋升为怪人 (圣者)。
					[c/FF0000:仪式要求：在序列4状态下，3次于<10%血量时存活并恢复至60%+生命]
					你成了命运齿轮中无法被预测的那一环。
					[被动] 怪人之眼：暴击伤害 +30%
					[被动] 不可定数：致命伤30%几率被命运抹除 (30秒冷却)
					[被动] 概率反噬：身上每一个减益，运气提升 (最高+1.0)
					[被动] 厄运链：厄运领域的暴毙将传染给邻近敌人
					[主动] 命运骰子 (M键)：消耗 200 灵性投出骰子,1-6点对应六种命运效果。
					'''
			}

			ProphetPotion: {
				DisplayName: 序列2：先知魔药
				Tooltip:
					'''
					服用后晋升为先知 (半神 - 完整的神话生物形态)。
					[c/FF0000:仪式要求：在序列3状态下，让\"不可定数\"成功触发5次]
					你成了命运的宠儿，掌握了\"好运\"\"厄运\"\"预知\"三大下位权柄。
					[被动] 命运洞察：暴击伤害再+20% (共+50%)
					[被动] 命运的宠儿：幸运 +2.0
					[被动] 水银之躯：受到伤害后10秒内免疫一切伤害与减益 (60秒CD)
					[被动] 预言术：杀敌时几率预言下一击，命中即秒杀 (Boss扣20%血)
					[主动] 福祸之言-福 (默认K，30s CD)：消耗300灵性，4000范围友军获60秒10种增益，立刻满血+满灵性。
					[主动] 福祸之言-祸 (默认L，30s CD)：消耗300灵性，4000范围敌人受当前血25%真伤(Boss10%)，60秒8种厄运。
					[主动] 命运启示 (默认U，60s CD)：消耗500灵性，10秒内所有概率事件偏向最优解。
					'''
			}

			SerpentPotion: {
				DisplayName: 序列1：水银之蛇魔药
				Tooltip:
					'''
					服用后晋升为水银之蛇。
					[c/FF0000:仪式要求：在序列2状态下,触发命运启示5次,且击败月亮领主]
					你成了命运的化身,掌握\"循环\"\"保存\"\"选择\"三大下位权柄。
					[被动] 命运之蛇之躯：生命+2500/通用伤+50%/暴击+35/防御+80/免伤+20%/攻速+40%/移速+50%
					[被动] 万物之蛇：暴击伤害再+30% (累积+80%)
					[被动] 命运的化身：幸运 +5.0
					[被动] 隐藏命运：免疫几乎所有 debuff
					[被动] 水银相位：每10秒进入3秒完全无敌
					[被动] 重启循环：死亡瞬间消耗5000灵性,自动回到10秒前(10分钟CD)
					[主动] 命运循环 (默认Y)：1000灵性,800范围5秒后回滚敌人位置(Boss除外)
					[主动] 主动重启 (默认H)：3000灵性,主动撤退至10秒前(满血+清debuff,3分钟CD)
					'''
			}

