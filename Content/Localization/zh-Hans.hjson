		# ==========================================
		#              NPCs (Monsters/Bosses)
		# ==========================================
		NPCs: {
			Aurmir.DisplayName: 黄昏巨人·奥尔米尔
			TestBoss.DisplayName: 测试Boss

			DogNPC: {
				DisplayName: 卷毛狒狒

				TownNPCMood: {
					Princess_LovesNPC: 我喜欢 {NPCName}。
					LikeNPC_Princess: 我喜欢 {NPCName}。
					HateCrowded: 我讨厌这么拥挤。
					DislikeCrowded: 我不喜欢这么拥挤。
					LoveSpace: 我非常喜欢有这么大的空间。
					FarFromHome: 我离家太远了。
					NoHome: 我讨厌没有家。
					Content: 我很满足。
				}
			}

			DunnSmith: {
				TownNPCMood: {
					// Princess_LovesNPC: 我喜欢 {NPCName}。
					// LikeNPC_Princess: 我喜欢 {NPCName}。
					HateCrowded: 太吵了...就像是有无数个疯狂的声音在耳边低语，我必须尽快离开这里。
					DislikeCrowded: 周围的人太多了，各种杂乱的思绪混杂在一起，让我的太阳穴隐隐作痛。
					LoveSpace: 这种空旷的环境很好，有助于安抚焦躁的灵性，减少失控的风险。
					FarFromHome: 我离廷根市太远了，希望伦纳德和弗莱能处理好那里的突发状况。
					NoHome: 我需要一个有屋顶的地方来存放查查林格协会的封印物，露宿街头太危险了。
					Content: 这里很安静，灵性的波动也很平稳，非常适合思考案情。
				}

				DisplayName: 邓恩·史密斯
			}

			OldNeil: {
				TownNPCMood: {
					Princess_LovesNPC: 我想听听老尼尔讲关于神灵的故事！
					LikeNPC_Princess: 多么可爱的孩子，让我想起了...
					HateCrowded: 人太多了！我都听不清女神的启示了！
					DislikeCrowded: 太吵了...这让我很难集中精神调配魔药。
					LoveSpace: 这里很宽敞，即使在这练习格斗也没问题。
					FarFromHome: 这里离廷根市太远了，我没法去熟悉的咖啡馆了。
					NoHome: 我需要一个住处，最好离邓恩远一点，免得他催我工作。
					Content: 这种安宁的感觉真不错...只要不用写报销单。
				}

				DisplayName: 老尼尔
			}
		}

		# ==========================================
		#              Buffs
		# ==========================================
		Buffs: {
			TamedBuff: {
				DisplayName: 血仆契约
				Description: 这个生物已经被你驯服，将为你而战！
			}

			ConquerorWill: {
				DisplayName: 征服意志
				Description: 被征服者的威压震慑，无法动弹。
			}

			YesterdayBuff: {
				DisplayName: 昨日重现
				Description: 你向过去的自己借取了力量，全属性大幅提升！
			}

			MarionetteTownNPCBuff: {
				DisplayName: 秘偶化
				Description: 这个人已经成为了你的提线木偶...
			}

			SpiritControlDebuff: {
				DisplayName: 灵体受控
				Description: 思维迟缓，身体僵硬。
			}

			AbyssShacklesDebuff: {
				DisplayName: 深渊枷锁
				Description: 被深渊的寒冷锁链束缚，无法移动。
			}

			FoolCurseBuff: {
				Description:
					'''
					[c/FF0000:副作用生效中]
					你的肉体如纸般脆弱。
					物理防御归零 | 生命上限降低40% | 受到接触伤害翻倍
					'''
				DisplayName: 体质孱弱
			}

			GiantCurseBuff: {
				DisplayName: 神性僵化
				Description:
					'''
					[c/FF0000:副作用生效中]
					为了容纳巨人的力量，你的肉体密度已超越钢铁。
					飞行能力被封印/削弱 | 移动速度上限锁死 | 无法二段跳
					'''
			}

			HunterCurseBuff: {
				DisplayName: 战争渴望
				Description:
					'''
					[c/FF0000:副作用生效中]
					没有鲜血的滋润，伤口无法愈合。
					无法自然回血 | 基础防御降低 | (入水时惩罚翻倍)
					'''
			}

			MoonCurseBuff: {
				DisplayName: 吸血鬼体质
				Description:
					'''
					[c/FF0000:副作用生效中]
					阳光在灼烧你的血液！
					生命极速流失 | 无法自然回血 | 攻击力减半
					'''
			}

			SanityDangerBuff: {
				DisplayName: 灵性枯竭
				Description:
					'''
					[c/FF0000:警告：灵性低于30%]
					意识正在模糊，现实开始扭曲...
					防御与伤害大幅降低 | 归零时将直接[失控]并重伤
					'''
			}

			SunCurseBuff: {
				DisplayName: 阳极必阴
				Description:
					'''
					[c/FF0000:副作用生效中]
					太阳已沉没，凡人的躯壳无法承载神性的重量。
					防御力归零 | 伤害降低60% | 受到伤害增加50% | 移动减慢
					'''
			}

			SunSuppressionDebuff: {
				Description: 你的超凡序列被暂时削弱了...
				DisplayName: 无暗压制
			}

			AfflictionCurseBuff: {
				// Description: Mods.zhashi.Buffs.AfflictionCurseBuff.Description
				// DisplayName: Affliction Curse Buff
			}

			TimeStagnationBuff: {
				// Description: Mods.zhashi.Buffs.TimeStagnationBuff.Description
				// DisplayName: Time Stagnation Buff
			}

			DemonessCurseBuff: {
				Description:
					'''
					魔女的宿命：痛苦与欢愉交织
					防御力降低20%，受到的伤害增加10%，生命回复减少
					身处火焰中时攻击力大幅降低
					'''
				DisplayName: 原初的诅咒
			}

			ExtremeBadLuckBuff: {
				DisplayName: 厄运缠身
				Description: 喝凉水都塞牙，走平地都摔跤...
			}

			WheelCurseBuff: {
				DisplayName: 星辰之灾
				Description:
					'''
					[c/FF0000:命运副作用生效中]
					你窥见了命运长河, 也成为长河的一部分。
					夜晚的地表, 星辰按照你的命运坠落 —— 砸向你。
					[c/FFD000:序列越高, 星辰坠落越密集, 单次伤害越大]
					'''
			}
		}

