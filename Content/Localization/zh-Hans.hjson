		# ==========================================
		#              Configs
		# ==========================================
		Configs: {
			LotMConfig: {
				DisplayName: 诡秘之主模组配置

				Headers: {
					// 平衡性设置: Balance Settings
					BaseSettings: 基础设置
					ChallengeSettings: 挑战与限制 (默认关闭)
					OtherSettings: 其他设置
					// 超凡生物模式: 超凡生物模式 Header
				}

				DynamicProgression: {
					Label: 启用动态世界等级
					Tooltip:
						'''
						根据当前世界击败的Boss（包括灾厄/瑟银等）动态调整属性。
						建议开启以获得最佳体验。
						'''
				}

				NerfDivineAbilities: {
					Label: 削弱神性技能 (平衡模式)
					Tooltip:
						'''
						开启后，无敌/秒杀类技能将变为高额减伤/高额伤害。
						(推荐追求平衡体验的玩家开启)
						'''
				}

				GlobalPowerMultiplier: {
					Label: 属性强度倍率
					Tooltip:
						'''
						全局调整模组增加的生命值、伤害和防御。
						1.0 为标准，0.5 为减半。
						'''
				}

				EnableSanitySystem: {
					Label: "[方案1] 启用理智值系统"
					Tooltip:
						'''
						开启后，维持高阶技能或开启领域将持续消耗理智。
						理智低于30%会导致属性削弱、画面扭曲甚至直接死亡。
						'''
				}

				EnableWorldRestriction: {
					Label: "[方案2] 启用世界位格压制"
					Tooltip:
						'''
						开启后，你的非凡能力上限将受限于泰拉瑞亚的世界进度。
						(例如：肉山前最多发挥序列6的实力)
						'''
				}

				EnableDivineCurse: {
					Label: "[方案3] 启用神性副作用"
					Tooltip:
						'''
						开启后，每条途径都会获得致命弱点。
						(例如：太阳途径在夜晚防御减半，月亮途径在白天室外掉血，巨人途径移速降低，猎人途径一段时间内不攻击生物降低回血速度，愚者与错误防御归零等)
						'''
				}

				CalamityAdaptationMode: {
					// Label: 灾厄适配模式
					/* Tooltip:
						'''
						开启后：
						1. 玩家造成的伤害降低 60%，防御降低 40%
						2. 只有击败特定 Boss 后才能服用对应序列的魔药
						''' */
				}

				EnableBeyonderCreatures: {
					// Label: 生物超凡化
					/* Tooltip:
						'''
						开启后:全游戏所有生成的生物有几率成为某途径某序列的超凡者
						序列越低=几率越小=强度越高
						序列9=10%, 序列8=5%, 序列7=1%, ..., 序列0=0.0001%
						超凡生物拥有强化数值+自动技能+Boss血条+丰厚掉落
						[序列0生物可以秒杀玩家,慎开]
						''' */
				}
			}

